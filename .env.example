DATABASE_URL=postgresql://indiair:password@localhost:5432/indiair
ES_HOST=http://localhost:9200
ES_INDEX_NAME=india_ir_content
S3_BUCKET=indiair-raw-pdfs
LOCAL_STORAGE_PATH=./data/raw_pdfs
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
USE_AWS_TEXTRACT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
BSE_POLL_INTERVAL_SECONDS=86400
BSE_REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
MIN_CHARS_PER_PAGE=200
MIN_TEXT_QUALITY_SCORE=0.7
RESTATEMENT_THRESHOLD=0.05
FINANCIAL_CONSISTENCY_TOLERANCE=0.02
LOG_LEVEL=INFO
LOG_FORMAT=json
API_BASE_URL=http://localhost:8000
POSTGRES_PASSWORD=password
