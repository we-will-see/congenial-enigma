DATABASE_URL=postgresql://indiair:password@localhost:5432/indiair
LOCAL_STORAGE_PATH=./data/documents
MAX_UPLOAD_BYTES=52428800
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
USE_AWS_TEXTRACT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
BSE_POLL_INTERVAL_SECONDS=86400
BSE_REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
MIN_CHARS_PER_PAGE=200
MIN_TEXT_QUALITY_SCORE=0.7
RESTATEMENT_THRESHOLD=0.05
FINANCIAL_CONSISTENCY_TOLERANCE=0.02
LOG_LEVEL=INFO
LOG_FORMAT=json
POSTGRES_PASSWORD=password
