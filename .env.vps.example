# The deployment helper replaces this automatically on first run.
POSTGRES_PASSWORD=CHANGE_ME

# Bind to 127.0.0.1 for an SSH-tunnel-only test. Use 0.0.0.0 only after
# restricting port 8000 with your VPS firewall or adding an HTTPS proxy.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
APP_WORKERS=2

LOCAL_STORAGE_PATH=/app/data/documents
MAX_UPLOAD_BYTES=52428800
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional. Keyword notebook search works without either key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=

USE_AWS_TEXTRACT=false
AWS_REGION=ap-south-1
